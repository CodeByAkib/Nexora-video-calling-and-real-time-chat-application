# ===== Nexora backend (Node/Express) - copy to .env and fill in. NEVER commit .env =====

# Port the API listens on. Render sets this automatically.
PORT=
# development | production   (set to "production" on the hosting platform)
NODE_ENV=

# REQUIRED. MongoDB connection string (MongoDB Atlas: Connect -> Drivers). Secret.
MONGO_URI=

# REQUIRED. Long random string used to sign login cookies. 32+ characters. Secret.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET_KEY=
# REQUIRED. Stream (getstream.io) -> your app -> API keys.
# The KEY is public (it is also used in the frontend); the SECRET must stay on the server.
STREAM_API_KEY=
STREAM_API_SECRET=

# REQUIRED in production. Exact public origin(s) of the frontend, comma-separated, no trailing slash
# and no path. Used for CORS and the CSRF origin check. Example: https://nexora.vercel.app
CLIENT_URL=

# Optional. strict (default) | lax | none.
# Leave as strict when the browser talks to the API through the same site (Vercel rewrite).
# "none" is only for a cross-site setup (frontend and API on different domains); it forces Secure cookies.
# COOKIE_SAME_SITE=strict

# Optional. Number of reverse proxies in front of the API (default 1 in production, 0 locally).
# Use 2 when requests pass through a Vercel rewrite AND Render's proxy.
# TRUST_PROXY=1
