# ===== Nexora frontend (Vite) - copy to .env. Variables here are PUBLIC (bundled into the site). =====

# REQUIRED. Stream PUBLIC API key (safe to expose). Never put the Stream secret here.
VITE_STREAM_API_KEY=

# Optional. Full URL of the API INCLUDING /api, e.g. https://nexora-api.onrender.com/api
# Leave unset to use the relative "/api" path (local dev uses http://localhost:5001/api automatically,
# and production expects a Vercel rewrite from /api to the backend - see README).
# VITE_API_URL=
